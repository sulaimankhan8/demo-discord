# Settings for the Android app build (npm run build:app).
# Copy this file to .env.capacitor and fill it in. .env.capacitor is git-ignored.

# Backend the app connects to. On a phone, "localhost" means the phone itself, so use your
# computer's network address (same Wi-Fi) or your deployed server.
#   Real phone on your Wi-Fi:  http://192.168.x.x:4000
#   Android emulator:          http://10.0.2.2:4000
#   Production:                https://api.example.com
NEXT_PUBLIC_API_URL=http://192.168.1.2:4000
NEXT_PUBLIC_SOCKET_URL=http://192.168.1.2:4000

# Set to true only while the backend above uses plain http (development).
# Release builds should use an https backend and leave this false.
CAP_ALLOW_HTTP=true
