# Settings for the desktop app build (npm run desktop).
# Copy this file to .env.desktop and fill it in. .env.desktop is git-ignored.
# Without it, the build uses .env.capacitor if you have one.

# Backend the desktop app connects to. On the same PC as the backend, localhost works.
#   Same PC:        http://localhost:4000
#   Another PC:     http://192.168.x.x:4000
#   Production:     https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
